{
    "version": "2.0.0",
    "tasks": [
      {
        "label": "go: build (debug)",
        "type": "shell",
        "command": "go",
        "args": [
          "build",
          "-gcflags=-m=2 -N -l",             // 禁用内联与优化，确保能单步调试
          "-o",
          "${workspaceFolder}/demo/demo"   // 输出到 demo_exec 二进制
        ],
        "options": {
          "cwd": "${workspaceFolder}/demo"
        },
        "problemMatcher": ["$go"]
      }
    ]
  }
  